# Connection string for the application + migrations.
# scripts/db-up.sh writes a working value into .env.local automatically.
# In production this points at a Neon pooled URI; in dev it points at
# either the local docker-compose Postgres or a system Postgres install.
DATABASE_URL=postgres://tilbudstrolden:tilbudstrolden_dev@127.0.0.1:5432/tilbudstrolden

# Optional: which household_id this MCP server operates on by default.
# Set this so single-tenant dev / single-user clients don't need auth.
# Auth (station 3) will replace this with per-request token-derived values.
# Generate one with: node -e "console.log(crypto.randomUUID())"
# TILBUDSTROLDEN_HOUSEHOLD_ID=

# Legacy: path to a v0.4 JSON store, used by `npm run db:import-json`.
# TILBUDSTROLDEN_DATA=~/.tilbudstrolden.json
