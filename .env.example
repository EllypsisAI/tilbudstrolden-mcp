# ---------------------------------------------------------------------------
# Database (stdio + HTTP runners both need this)
# ---------------------------------------------------------------------------

# Connection string for the application + migrations.
# scripts/db-up.sh writes a working value into .env.local automatically.
# In production this points at a Neon pooled URI; in dev it points at
# either the local docker-compose Postgres or a system Postgres install.
DATABASE_URL=postgres://tilbudstrolden:tilbudstrolden_dev@127.0.0.1:5432/tilbudstrolden

# ---------------------------------------------------------------------------
# stdio runner (npm start / npm run dev)
# ---------------------------------------------------------------------------

# Which household this single-tenant stdio runner operates on.
# Required for stdio mode. The HTTP runner ignores it — per-request OAuth
# derives the household from the JWT instead.
# Generate one with: node -e "console.log(crypto.randomUUID())"
# TILBUDSTROLDEN_HOUSEHOLD_ID=

# Legacy: path to a v0.4 JSON store, used by `npm run db:import-json`.
# TILBUDSTROLDEN_DATA=~/.tilbudstrolden.json

# ---------------------------------------------------------------------------
# HTTP runner (npm run dev:http / npm run start:http) — WorkOS OAuth
# ---------------------------------------------------------------------------
# See docs/workos-setup.md for how to populate these.

# Public-facing base URL the MCP host will use to reach this server.
# In dev with `cloudflared tunnel --url http://localhost:3000`, this is
# the tunnel's public hostname. Must be reachable from the OAuth client.
# PUBLIC_BASE_URL=http://localhost:3000

# WorkOS environment issuer URL — visible in WorkOS dashboard. AuthKit
# typically issues this as `https://api.workos.com/user_management/<id>`
# or your custom AuthKit domain.
# WORKOS_ISSUER_URL=

# WorkOS client ID for this environment.
# WORKOS_CLIENT_ID=

# Optional: override the JWKS URL. Defaults to <WORKOS_ISSUER_URL>/.well-known/jwks.json.
# WORKOS_JWKS_URL=

# Port + bind host. Default 127.0.0.1:3000 with DNS-rebinding protection
# enabled automatically by the SDK.
# PORT=3000
# HOST=127.0.0.1
