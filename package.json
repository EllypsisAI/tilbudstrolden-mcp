{
  "name": "tilbudstrolden-mcp",
  "version": "0.5.1",
  "type": "module",
  "description": "MCP server for Nordic grocery deal hunting (Denmark, Norway, Sweden, Finland). Search offers, score recipes against current deals, and generate optimized shopping lists.",
  "author": "Olga Safonova",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/olgasafonova/tilbudstrolden-mcp.git"
  },
  "homepage": "https://github.com/olgasafonova/tilbudstrolden-mcp",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "grocery",
    "deals",
    "tilbud",
    "danish",
    "etilbudsavis",
    "meal-planning",
    "shopping-list",
    "claude",
    "ai-tools"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "dist/server.js",
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:http": "node dist/server-http.js",
    "dev": "tsx watch src/server.ts",
    "dev:http": "tsx watch src/server-http.ts",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "bash scripts/db-up.sh",
    "db:down": "bash scripts/db-down.sh",
    "db:reset": "bash scripts/db-down.sh --volumes && bash scripts/db-up.sh && npm run db:migrate && npm run db:bootstrap",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:bootstrap": "tsx src/db/bootstrap.ts",
    "db:generate": "drizzle-kit generate",
    "db:import-json": "tsx scripts/import-json-store.ts",
    "setup": "npm run db:up && npm run db:migrate && npm run db:bootstrap",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "pg": "^8.21.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "path-to-regexp": "^8.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.2"
  }
}
